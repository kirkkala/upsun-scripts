#!/bin/bash

# upsun-db-dump — dumps the Upsun database to db_dumps directory for the current git branch environment

set -euo pipefail

_common="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/upsun-scripts-common.sh"
[[ -f "$_common" ]] || _common="/usr/local/lib/kirkkala-upsun/upsun-scripts-common.sh"
# shellcheck source=src/upsun-scripts-common.sh
source "$_common"

show_help() {
  cat << EOF

${COLOR_GREEN}upsun-db-dump${COLOR_RESET} — dumps the Upsun database to db_dumps directory for the current git branch environment
${COLOR_BLUE}${TOOL_NAME}${COLOR_RESET} — unofficial helpers, not affiliated with Upsun.

${COLOR_BLUE}USAGE${COLOR_RESET}
  ${COLOR_GREEN}upsun-db-dump${COLOR_RESET}
  ${COLOR_GREEN}upsun-db-dump${COLOR_RESET} --help
  ${COLOR_GREEN}upsun-db-dump${COLOR_RESET} --version

${COLOR_BLUE}WHAT IT DOES${COLOR_RESET}
  Runs from a git repository linked to an Upsun project.
  Dumps the database for the current branch into:

    ${COLOR_YELLOW}<repo>/drupal/db_dumps/${COLOR_RESET}  if that directory already exists
    ${COLOR_YELLOW}<repo>/db_dumps/${COLOR_RESET}         otherwise

  Filename:

    ${COLOR_YELLOW}YYYY-MM-DD-HHMM-<project>-<branch>.sql${COLOR_RESET}

${COLOR_BLUE}REQUIREMENTS${COLOR_RESET}
  • git
  • Upsun CLI (${COLOR_GREEN}upsun${COLOR_RESET}) — https://docs.upsun.com/administration/cli/

EOF
  exit 0
}

if [[ "${1:-}" == "--help" ]] || [[ "${1:-}" == "-h" ]] || [[ "${1:-}" == "help" ]]; then
  show_help
fi

if [[ "${1:-}" == "--version" ]] || [[ "${1:-}" == "-v" ]]; then
  echo "upsun-db-dump $VERSION — $TOOL_NAME"
  exit 0
fi

upsun_require_project
upsun_require_branch
upsun_require_project_link "upsun-db-dump can dump the current branch"

dir="$root/db_dumps"
if [[ -d "$root/drupal/db_dumps" ]]; then
  dir="$root/drupal/db_dumps"
fi

mkdir -p "$dir"

# Branch names can contain slashes; keep the filename on one path segment.
safe_branch=${branch//\//-}
file="$dir/$(date +%Y-%m-%d-%H%M)-$(basename "$root")-${safe_branch}.sql"

echo -e "${COLOR_BLUE}${TOOL_NAME}${COLOR_RESET} · ${COLOR_GREEN}upsun-db-dump${COLOR_RESET}"
echo -e "${COLOR_BLUE}Dumping database for branch ${COLOR_GREEN}${branch}${COLOR_RESET}"
echo -e "${COLOR_BLUE}→ ${COLOR_YELLOW}${file}${COLOR_RESET}"
echo ""

upsun db:dump --file="$file" --environment="$branch"

echo ""
echo -e "${COLOR_GREEN}✓ Dump saved to ${file}${COLOR_RESET}"
